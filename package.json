{
  "name": "mathcha-local",
  "version": "1.1.0",
  "private": true,
  "description": "Mathcha 网页编辑器离线本地版：完整源码仓库，npm / pnpm 一键启动",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node tools/dev.mjs --open",
    "start": "node tools/dev.mjs",
    "serve": "node tools/dev.mjs --no-open",
    "check": "node tools/check.mjs",
    "test": "node tools/check.mjs --with-smoke",
    "fetch": "node tools/run-python.mjs tools/fetch_assets.py",
    "unpack": "node tools/unpack.mjs",
    "md:import": "node tools/run-python.mjs src/md/convert.py import",
    "md:export": "node tools/run-python.mjs src/md/convert.py export",
    "md:list": "node tools/run-python.mjs src/md/convert.py list",
    "clean": "node tools/clean.mjs"
  },
  "devDependencies": {
    "@babel/generator": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/types": "^7.24.0"
  }
}
